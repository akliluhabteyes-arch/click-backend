# Template only — copy to .env and fill in. Never put real keys in this file.

# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8080
# Set to true when running behind a proxy / load balancer (Render, Railway, Nginx...)
TRUST_PROXY=false

# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Not used by the server; kept for reference
SUPABASE_ANON_KEY=

# ---- Cloudinary (Dashboard → API Keys) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for all uploads
CLOUDINARY_FOLDER=clickaddis

# ---- Admin panel auth ----
# Long random string (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
